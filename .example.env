CEB_BASE_API_URL=https://api.optimai.im
CEB_XAGENT_URL=https://app.optimai.im
# Origin of the OptimAI Agentic server. The build reads this, both for the code
# that calls it and for the manifest's host_permissions. Rebuild after changing it.
# Defaults to the hosted server. Use http://localhost:8787 for a local one.
CEB_CATALYST_API_URL=https://agentic-api.optimai.network
